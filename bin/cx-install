#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && printf '%s/' "$PWD")"
REPO_ROOT="${REPO_ROOT%/}"
if [[ -n "${CX_SHELL_RC:-}" ]]; then
  SHELL_RC="${CX_SHELL_RC}"
elif [[ -f "${HOME}/.bash_profile" ]]; then
  SHELL_RC="${HOME}/.bash_profile"
elif [[ -f "${HOME}/.profile" ]]; then
  SHELL_RC="${HOME}/.profile"
else
  SHELL_RC="${HOME}/.bash_profile"
fi
quote_literal() {
  local value="$1"
  printf "'"
  while [[ "$value" == *"'"* ]]; do
    printf '%s%s' "${value%%\'*}" "'\\''"
    value="${value#*\'}"
  done
  printf "%s'" "$value"
}

LINE="source $(quote_literal "${REPO_ROOT}/cx.sh")"
LEGACY_LINE="source \"${REPO_ROOT}/cx.sh\""
# The previous pwd capture stripped trailing newlines from checkout paths.
LEGACY_ROOT="$(printf '%s' "$REPO_ROOT")"
LEGACY_TRIM="source \"${LEGACY_ROOT}/cx.sh\""

filter_registration() {
  local remaining registration ending matched
  # Match whole records, including embedded newlines and an unterminated final line.
  remaining="$(cat "$SHELL_RC"; printf '.')"
  remaining="${remaining%.}"
  registration_seen=0
  while [[ -n "$remaining" ]]; do
    matched=0
    for registration in "$LINE" "$LEGACY_LINE" "$LEGACY_TRIM"; do
      if [[ "$remaining" == "$registration" ]]; then
        remaining=""
        ending=""
        matched=1
      elif [[ "$remaining" == "$registration"$'\n'* ]]; then
        remaining="${remaining#"$registration"$'\n'}"
        ending=$'\n'
        matched=1
      fi
      if [[ "$matched" == "1" ]]; then
        if [[ "$registration_mode" == "install" && "$registration_seen" == "0" ]]; then
          printf '%s%s' "$LINE" "$ending"
        fi
        registration_seen=1
        break
      fi
    done
    if [[ "$matched" == "1" ]]; then
      continue
    fi
    if [[ "$remaining" == *$'\n'* ]]; then
      printf '%s\n' "${remaining%%$'\n'*}"
      remaining="${remaining#*$'\n'}"
    else
      printf '%s' "$remaining"
      remaining=""
    fi
  done
}

if [[ ! -f "$SHELL_RC" ]]; then
  touch "$SHELL_RC"
fi

registration_mode=install
tmp="$(mktemp)"
filter_registration > "$tmp"
if [[ "$registration_seen" == "1" ]]; then
  echo "XSHELF/CX shell utilities already installed in $SHELL_RC"
else
  {
    echo
    echo "# XSHELF/CX utilities"
    printf '%s\n' "$LINE"
  } >> "$tmp"
  echo "Installed XSHELF/CX shell utilities into $SHELL_RC"
fi

if cmp -s "$tmp" "$SHELL_RC"; then
  rm "$tmp"
else
  # Follow the selected profile path, preserving its link, mode, and inode.
  cat "$tmp" > "$SHELL_RC"
  rm "$tmp"
fi

install_manpage() {
  local src="${REPO_ROOT}/docs/man/cx.1"
  [[ -f "$src" ]] || return 0

  local candidates=()
  if command -v brew >/dev/null 2>&1; then
    local hb_prefix
    hb_prefix="$(brew --prefix 2>/dev/null || true)"
    if [[ -n "$hb_prefix" ]]; then
      candidates+=("$hb_prefix/share/man/man1")
    fi
  fi
  candidates+=(
    "/opt/homebrew/share/man/man1"
    "/usr/local/share/man/man1"
    "$HOME/.local/share/man/man1"
    "$HOME/man/man1"
  )

  local target=""
  local dir
  for dir in "${candidates[@]}"; do
    if mkdir -p "$dir" 2>/dev/null; then
      target="$dir"
      break
    fi
  done
  if [[ -z "$target" ]]; then
    echo "cx-install: warning: could not install XSHELF/CX man pages into a writable manpath target" >&2
    return 0
  fi

  cp "$src" "$target/cx.1"
  cp "$src" "$target/xshelf.1"
  cp "$src" "$target/xs.1"
  echo "Installed man pages: $target/cx.1, $target/xshelf.1, and $target/xs.1"
}

install_manpage

printf 'Run: source %s\n' "$(quote_literal "$SHELL_RC")"
